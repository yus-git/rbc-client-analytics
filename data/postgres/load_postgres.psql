\cd data
\set ON_ERROR_STOP on

BEGIN;

CREATE SCHEMA IF NOT EXISTS ca_demo;

CREATE TABLE ca_demo."fact_opportunity" (
    "OpportunityKey" bigint NOT NULL,
    "CreatedDateKey" integer NOT NULL,
    "ExpectedCloseDateKey" integer NOT NULL,
    "ActualCloseDateKey" integer NULL,
    "ClientKey" integer NOT NULL,
    "AdvisorKey" integer NOT NULL,
    "ProductKey" integer NOT NULL,
    "CampaignKey" integer NOT NULL,
    "Stage" text NOT NULL,
    "EstimatedValueCAD" decimal(18,2) NOT NULL,
    "Probability" decimal(4,3) NOT NULL,
    "IsSynthetic" boolean NOT NULL,
    PRIMARY KEY ("OpportunityKey")
);

\copy ca_demo."fact_opportunity" FROM 'fact_opportunity.csv' WITH (FORMAT csv, HEADER true, NULL '')

DO $$ BEGIN IF (SELECT count(*) FROM ca_demo."fact_opportunity") <> 15000 THEN RAISE EXCEPTION 'Row count mismatch: fact_opportunity'; END IF; END $$;

COMMIT;
